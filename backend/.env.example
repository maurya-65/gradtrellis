DATABASE_URL=postgres://postgres:postgres@localhost:5432/gradtrellis
PORT=3000

# Only for npm test; the API tests are skipped without it. Its tables get wiped.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/gradtrellis_test

# Where links in emails point (the frontend)
APP_URL=http://localhost:5173

# The advisor's free-tier model chain, tried in this order; leave any out. Without keys the
# advisor still works, with local ranking only. Model names can be overridden (GROQ_MODEL, ...).
GROQ_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=
